{
  "name": "@ovacanvas/2d",
  "version": "3.17.2",
  "description": "The 2D scene system, components and interaction for OvaCanvas",
  "author": "OvaCanvas contributors",
  "homepage": "https://github.com/wilmhurst-ski/ovacanvas",
  "bugs": "https://github.com/wilmhurst-ski/ovacanvas/issues",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "dev": "tspc -p src/lib -w",
    "build": "npm run build-lib && npm run build-editor",
    "build-lib": "tspc -p src/lib/tsconfig.build.json",
    "build-editor": "rollup -c rollup.editor.mjs",
    "bundle": "rollup -c rollup.config.mjs",
    "test": "vitest"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilmhurst-ski/ovacanvas.git"
  },
  "files": [
    "lib",
    "editor",
    "src",
    "tsconfig.project.json"
  ],
  "devDependencies": {
    "@ovacanvas/internal": "0.0.0",
    "@ovacanvas/ui": "^3.17.2",
    "@preact/signals": "^1.2.1",
    "clsx": "^2.0.0",
    "jsdom": "^22.1.0",
    "preact": "^10.19.2",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.1",
    "@dagrejs/dagre": "3.1.1",
    "@lezer/common": "^1.2.1",
    "@lezer/highlight": "^1.2.0",
    "@ovacanvas/core": "^3.17.2",
    "code-fns": "^0.8.2",
    "d3-delaunay": "6.0.4",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "escape-string-regexp": "^5.0.0",
    "gl-matrix": "3.4.3",
    "martinez-polygon-clipping": "0.8.1",
    "mathjax-full": "^3.2.2",
    "parse-svg-path": "^0.1.2"
  }
}
