      "id": "proof",
      "kit": "derivation",
      "region": "right",
      "steps": [
        {"tex": "\\text{Prove that } \\frac{KL}{MN} = \\frac{PK^2}{PN^2}"},
        {
          "tex": "\\frac{KL}{MN} = \\frac{PK}{PN} \\cdot \\frac{\\sin \\gamma}{\\sin \\beta}",
          "why": "\\text{from } \\triangle KLP \\text{ and } \\triangle PMN"
        },
        {
          "tex": "\\frac{\\sin \\gamma}{\\sin \\beta} = \\frac{PK}{PN}",
          "why": "\\text{from } \\triangle PKN"
        },
        {
          "tex": "\\therefore \\frac{KL}{MN} = \\frac{PK^2}{PN^2} \\quad \\blacksquare"
        }
      ]
    }
