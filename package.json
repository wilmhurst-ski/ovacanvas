{
  "name": "ovacanvas",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run core:build && npm run 2d:build && npm run host:build && npm run wire:build",
    "test": "npm run test -w packages/core -- --run && npm run test -w packages/2d -- --run && npm run test -w packages/host -- --run && npm run test -w packages/wire && npm run test -w packages/studio",
    "core:dev": "npm run dev -w packages/core",
    "core:build": "npm run build -w packages/core",
    "core:bundle": "npm run bundle -w packages/core",
    "core:test": "npm run test -w packages/core",
    "2d:dev": "npm run dev -w packages/2d",
    "2d:build": "npm run build -w packages/2d",
    "2d:bundle": "npm run bundle -w packages/2d",
    "2d:test": "npm run test -w packages/2d",
    "host:build": "npm run build -w packages/host",
    "host:test": "npm run test -w packages/host",
    "sync": "node tools/sync-workspace-packages.mjs",
    "postinstall": "node tools/sync-workspace-packages.mjs",
    "studio:dev": "npm run dev -w packages/studio",
    "studio:test": "npm run test -w packages/studio",
    "studio:typecheck": "npm run typecheck -w packages/studio",
    "corpus": "node tools/run-corpus.mjs",
    "verify:live": "node tools/verify-live.mjs",
    "check:provider": "node tools/check-provider.mjs",
    "eslint": "eslint \"**/*.ts?(x)\"",
    "eslint:fix": "eslint --fix \"**/*.ts?(x)\"",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "wire:build": "npm run build -w packages/wire",
    "wire:test": "npm run test -w packages/wire",
    "wire:catalogue": "npm run catalogue -w packages/wire",
    "wire:mcp": "npm run mcp -w packages/wire"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "typescript": "^5.2.2",
    "rollup": "4.5.0",
    "vite": "^4.5.0"
  }
}
